<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- anel em degradê -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FFC06A"
                android:centerColor="#FF9800"
                android:endColor="#FF6A00" />
        </shape>
    </item>
    <!-- miolo escuro (cria o anel) -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#1C1C20"
                android:endColor="#101012" />
        </shape>
    </item>
</layer-list>
