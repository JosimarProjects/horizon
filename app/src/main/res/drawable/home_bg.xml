<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base escura -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#000000"
                android:centerColor="#0C0C0E"
                android:endColor="#060606" />
        </shape>
    </item>
    <!-- glow suave de accent atrás do botão -->
    <item
        android:width="620dp"
        android:height="620dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="310dp"
                android:startColor="#2EFF9800"
                android:endColor="#00FF9800" />
        </shape>
    </item>
</layer-list>
